# ===========================================
# DEVELOP ENVIRONMENT OVERRIDES
# ===========================================
# Copy to `.env.develop`. Loaded on top of the root `.env` by
# `scripts/with-env.mjs` when you run `npm run dev` / `npm run build:local`.
#
# Only put values here that differ between develop and prod — everything else
# (project ID, tokens, reCAPTCHA keys, …) stays in the root `.env`.
#
# Note: SANITY_DATASET and SANITY_STUDIO_DATASET are forced to `develop` by the
# wrapper script, so you do not need to set them.

# Where the Studio's Presentation tool opens previews
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Absolute base URL used for sitemaps and canonical links
SITE_URL=http://localhost:3000

# Keep non-production content out of search results
ALLOW_CRAWLERS=false
