# ===========================================
# PROD ENVIRONMENT OVERRIDES
# ===========================================
# Copy to `.env.prod`. Loaded on top of the root `.env` by
# `scripts/with-env.mjs` when you run `npm run dev:prod` /
# `npm run build:local:prod`.
#
# This targets the live dataset. Reads are safe; anything you publish from a
# Studio pointed here goes to the production site.
#
# Note: SANITY_DATASET and SANITY_STUDIO_DATASET are forced to `prod` by the
# wrapper script, so you do not need to set them.

# Where the Studio's prod workspace opens previews
SANITY_STUDIO_PREVIEW_URL_PROD=https://your-domain.com

# Absolute base URL used for sitemaps and canonical links
SITE_URL=https://your-domain.com

# The live site is the only environment that should be indexable
ALLOW_CRAWLERS=true
