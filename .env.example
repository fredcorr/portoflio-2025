# ===========================================
# SHARED ENVIRONMENT VARIABLES
# ===========================================
# Single source of truth for all apps in the monorepo
# Copy this file to .env and fill in your actual values

# Sanity Configuration (define once, used by all apps)
SANITY_PROJECT_ID=your-project-id
# Which dataset to talk to. `npm run dev` / `dev:prod` set this for you via
# scripts/with-env.mjs; it only matters here as the fallback for a bare
# `turbo run dev`. Valid values: develop | prod
SANITY_DATASET=develop

# Sanity API Tokens (server-side only - used by Next.js)
SANITY_API_READ_TOKEN=your-read-token-here
# Write token for the Sanity MCP server — set in Claude Code web session env settings (never commit the actual value)
SANITY_API_WRITE_TOKEN=your-write-token-here
SANITY_STUDIO_PREVIEW_SECRET=your-preview-secret-here

# Sanity Presentation Tool (Visual Editing)
SANITY_STUDIO_URL=http://localhost:3333
# Preview target for the Studio's `develop` workspace
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
# Preview target for the Studio's `prod` workspace (falls back to the above)
SANITY_STUDIO_PREVIEW_URL_PROD=https://your-domain.com

# Studio Host (optional - for Sanity Studio deployment)
SANITY_STUDIO_HOST=your-studio-host

# Note:
# SANITY_STUDIO_PROJECT_ID and SANITY_STUDIO_DATASET are derived from
# SANITY_PROJECT_ID and SANITY_DATASET by scripts/with-env.mjs, so you only
# define them once here. Cloud builds (Vercel) bypass that script and must set
# the SANITY_STUDIO_* names directly — see README → Environments & datasets.

# Public contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@joey.co

# Mail app endpoint for form submissions
MAIL_APP_ENDPOINT=https://mail-app-omega.vercel.app/submit
SUBMISSION_SECRET=your-submission-secret

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Base URL for generating absolute links (e.g., sitemap)
SITE_URL=https://your-domain.com

# Allow or disallow crawlers via robots.txt (defaults to allow in production)
ALLOW_CRAWLERS=false

# Google Search Console dashboard widget
# Service account credentials — read-only access to Search Console data
# Get these from the service account JSON key file downloaded from Google Cloud Console
SANITY_STUDIO_GSC_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file; use literal \n for newlines
SANITY_STUDIO_GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# The exact property URL registered in Search Console (include trailing slash for URL-prefix properties)
SANITY_STUDIO_GSC_SITE_URL=https://your-domain.com/
