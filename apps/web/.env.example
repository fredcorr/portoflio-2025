# ===========================================
# WEB APP ENVIRONMENT VARIABLES
# ===========================================
# Copy to `.env.local` and fill in. Next.js loads `.env*` from this directory
# automatically — there is no root `.env`, and nothing is derived from one.

# --- Sanity ---
SANITY_PROJECT_ID=your-project-id

# Which dataset the site reads. Valid values: develop | prod
# Validated at startup against the SanityDataset enum in shared/types/base.ts,
# so a typo fails the build instead of rendering an empty site.
SANITY_DATASET=develop

# Server-side read token. Required for draft mode / Presentation previews, and
# for any dataset whose visibility is private.
SANITY_API_READ_TOKEN=your-read-token

# Shared secret guarding the /api/draft route
SANITY_STUDIO_PREVIEW_SECRET=your-preview-secret

# Studio origin, used to build stega links for visual editing
SANITY_STUDIO_URL=http://localhost:3333

# --- Site ---
# Absolute base URL for sitemap/canonical links
SITE_URL=http://localhost:3000
# Allow indexing. Should only ever be true for the production deployment.
ALLOW_CRAWLERS=false

# --- Forms ---
MAIL_APP_ENDPOINT=https://mail-app-omega.vercel.app/submit
SUBMISSION_SECRET=your-submission-secret
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# --- Client-side (these DO reach the browser) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
